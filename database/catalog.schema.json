{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ZZZ translation concepts v1",
  "description": "Complete concept records derived from the legacy catalog. This contract does not select an ambiguous meaning or confirm live release.",
  "type": "object",
  "required": [
    "format",
    "schemaVersion",
    "source",
    "languages",
    "concepts"
  ],
  "properties": {
    "format": {
      "const": "zzz-translation-concepts"
    },
    "schemaVersion": {
      "const": 1
    },
    "source": {
      "type": "object",
      "required": [
        "sha256",
        "sourceVersion",
        "retrievedAt"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sourceVersion": {
          "type": [
            "string",
            "null"
          ]
        },
        "retrievedAt": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "languages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "ko",
          "en",
          "ja",
          "zh-CN",
          "zh-Hant",
          "de",
          "fr",
          "es",
          "pt",
          "ru",
          "th",
          "vi",
          "id"
        ]
      }
    },
    "concepts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/concept"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1
    },
    "tag": {
      "enum": [
        "official",
        "unofficial",
        "needs-review"
      ]
    },
    "languageMap": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "ko",
          "en",
          "ja",
          "zh-CN",
          "zh-Hant",
          "de",
          "fr",
          "es",
          "pt",
          "ru",
          "th",
          "vi",
          "id"
        ]
      },
      "additionalProperties": {
        "$ref": "#/$defs/text"
      }
    },
    "concept": {
      "type": "object",
      "required": [
        "id",
        "category",
        "names",
        "aliases",
        "communityOutputs",
        "usage",
        "context",
        "availability",
        "classification",
        "tags"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "names": {
          "$ref": "#/$defs/languageMap"
        },
        "aliases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "communityOutputs": {
          "$ref": "#/$defs/languageMap"
        },
        "usage": {
          "type": "object",
          "required": [
            "meaning",
            "rule"
          ],
          "properties": {
            "meaning": {
              "$ref": "#/$defs/text"
            },
            "rule": {
              "$ref": "#/$defs/text"
            },
            "communityRule": {
              "$ref": "#/$defs/text"
            }
          },
          "additionalProperties": false
        },
        "context": {
          "type": "object",
          "required": [],
          "properties": {
            "characterId": {
              "$ref": "#/$defs/text"
            },
            "characterName": {
              "$ref": "#/$defs/languageMap"
            },
            "relatedSkills": {
              "$ref": "#/$defs/languageMap"
            }
          },
          "additionalProperties": false
        },
        "availability": {
          "type": "object",
          "required": [
            "releaseStatus",
            "autoUse"
          ],
          "properties": {
            "releaseStatus": {
              "enum": [
                "live",
                "prerelease",
                "unspecified"
              ]
            },
            "autoUse": {
              "type": "boolean"
            },
            "releaseVersion": {
              "$ref": "#/$defs/text"
            },
            "sourceVersion": {
              "$ref": "#/$defs/text"
            }
          },
          "additionalProperties": false
        },
        "classification": {
          "type": "object",
          "required": [
            "names",
            "aliases",
            "communityOutputs"
          ],
          "properties": {
            "names": {
              "type": "object",
              "propertyNames": {
                "enum": [
                  "ko",
                  "en",
                  "ja",
                  "zh-CN",
                  "zh-Hant",
                  "de",
                  "fr",
                  "es",
                  "pt",
                  "ru",
                  "th",
                  "vi",
                  "id"
                ]
              },
              "additionalProperties": {
                "$ref": "#/$defs/tag"
              }
            },
            "aliases": {
              "type": "object",
              "required": [
                "official",
                "unofficial",
                "needs-review"
              ],
              "properties": {
                "official": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/text"
                  }
                },
                "unofficial": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/text"
                  }
                },
                "needs-review": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/text"
                  }
                }
              },
              "additionalProperties": false
            },
            "communityOutputs": {
              "type": "object",
              "propertyNames": {
                "enum": [
                  "ko",
                  "en",
                  "ja",
                  "zh-CN",
                  "zh-Hant",
                  "de",
                  "fr",
                  "es",
                  "pt",
                  "ru",
                  "th",
                  "vi",
                  "id"
                ]
              },
              "additionalProperties": {
                "$ref": "#/$defs/tag"
              }
            }
          },
          "additionalProperties": false
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/tag"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
