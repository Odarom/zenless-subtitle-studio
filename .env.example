# Discord Developer Portal > Bot > Token
DISCORD_TOKEN=
# General Information > Application ID
DISCORD_APPLICATION_ID=
# 선택: 운영자 서버 ID. .env 기본 API/로컬 설정은 이 서버에만 적용됩니다.
# 다른 서버는 Discord /zzz api-set으로 API를 등록합니다.
DISCORD_GUILD_ID=
# 번역 방식: ollama (내 PC), gemini (무료 구간/유료), openai (유료)
TRANSLATION_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_CONTEXT_LENGTH=16384
# Gemini 무료 사용 여부는 Google AI Studio 프로젝트의 결제/한도 설정에 따릅니다.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
# openai 선택 시에만 필요합니다. 모든 키는 .env에만 입력하세요.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# 서울 시간 기준 하루 최대 AI 요청 횟수. 실패한 요청도 포함. 0이면 AI 호출 중지.
DAILY_REQUEST_LIMIT=200
MAX_MESSAGE_CHARS=2000
# 최근 원문 최대 4개를 문맥으로 사용. 0이면 문맥 전송 끄기.
CONTEXT_MESSAGES=4
MAX_OUTPUT_TOKENS=3000
# 이 설정을 생략하면 Gemini 60초 / OpenAI 30초 / 로컬 AI 2분. 숫자를 넣으면 해당 시간(밀리초)으로 고정.
# API_TIMEOUT_MS=60000
# official: 정식 명칭 우선 / community: 등록된 언어별 줄임말 우선, 없으면 정식 명칭
TRANSLATION_STYLE=community
